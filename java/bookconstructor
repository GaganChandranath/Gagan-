class Book {
   int bookId;
   String title;
   String author;
   double price;
   static int totalbooks = 0;
   Book(int id, String t, String a, double p) {
      bookId = id;
      title = t;
      author = a;
      price = p;
      totalbooks++; }
   void display() {
      System.out.println("Book ID : " + bookId);
      System.out.println("Title : " + title);
      System.out.println("Author : " + author);
      System.out.println("Price : " + price);
      System.out.println(); }
   void search(int id) {
      if (bookId == id)
         display();
      else
         System.out.println("Book ID not found");  }
   void search(String t) {
      if (title.equalsIgnoreCase(t))
         display();
      else
         System.out.println("Book title not found");
   }
   void costlierBook(Book b) {
      if (price > b.price)
         System.out.println(title + " is costlier.");
      else if (b.price > price)
         System.out.println(b.title + " is costlier.");
      else
         System.out.println("Both books have the same price.");
   }
   static void totalBooks() {
      System.out.println("Total books created: " + totalbooks);
   }
}

public class Main {
   public static void main(String[] args) {
      Book b1 = new Book(101, "Java ", "calr", 500);
      Book b2 = new Book(102, "Data ", "printrt", 650);
      Book b3 = new Book(103, "Computer ", "tim", 550);
      b1.display();
      b2.display();
      b3.display();
      System.out.println("Searching by Book ID:");
      b1.search(101);
      System.out.println("Searching by Title:");
      b2.search("Data ");
      System.out.println("Comparing books:");
      b1.costlierBook(b2);
      Book.totalBooks();
   }
}
